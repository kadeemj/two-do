default_platform(:ios)

APP_IDENTIFIER = "com.kadeem.twodo"
WIDGET_IDENTIFIER = "com.kadeem.twodo.widgets"
ALL_IDENTIFIERS = [APP_IDENTIFIER, WIDGET_IDENTIFIER]
# target name => bundle identifier, for per-target manual signing
SIGNED_TARGETS = { "TwoDo" => APP_IDENTIFIER, "TwoDoWidgets" => WIDGET_IDENTIFIER }
TEAM_ID = "JUQMKZZ7TJ"
XCODEPROJ = "TwoDo.xcodeproj"
SCHEME = "TwoDo"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Regenerate App Store profiles in the certs repo (run after adding a target or capability)"
  lane :sync_signing do
    setup_ci

    match(
      type: "appstore",
      app_identifier: ALL_IDENTIFIERS,
      api_key: asc_api_key,
      readonly: false,
      force: true
    )
  end

  desc "Build and upload to TestFlight (fully headless — API key auth, no 2FA)"
  lane :beta do
    setup_ci

    api_key = asc_api_key

    match(
      type: "appstore",
      app_identifier: ALL_IDENTIFIERS,
      api_key: api_key,
      readonly: true
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ).to_s.to_i + 1
    UI.message("Building as build number #{build_number}")

    profile_map = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    # xcargs apply to every target, so per-target profiles must be written into
    # the project instead of passed as PROVISIONING_PROFILE_SPECIFIER.
    SIGNED_TARGETS.each do |target, identifier|
      update_code_signing_settings(
        path: XCODEPROJ,
        targets: [target],
        build_configurations: ["Release"],
        use_automatic_signing: false,
        team_id: TEAM_ID,
        code_sign_identity: "Apple Distribution",
        profile_name: profile_map.fetch(identifier)
      )
    end

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      output_directory: "build",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      export_options: {
        provisioningProfiles: profile_map
      },
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
